    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "prisma": "^5.20.0",
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "cloudinary": "^2.5.1",
    "multer": "^2.4.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
