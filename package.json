{
  "name": "shop-backend",
  "version": "1.0.0",
  "description": "بک‌اند فروشگاه اینترنتی پوشاک",
  "main": "src/server.js",
  "scripts": {
    "build": "prisma generate",
    "test": "node --test test/*.test.js",
    "deploy:prepare": "prisma db execute --file db/add-site-content.sql --schema prisma/schema.prisma",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cloudinary": "^2.5.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.4.0",
    "prisma": "^5.20.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
