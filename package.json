{
  "name": "shop-backend",
  "version": "1.0.0",
  "description": "بک‌اند فروشگاه اینترنتی پوشاک",
  "main": "src/server.js",
  "scripts": {
    "build": "prisma generate",
    "test": "node --test test/*.test.js",
