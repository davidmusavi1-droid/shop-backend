datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String    @id @default(uuid())
  title       String
  description String?
  basePrice   Int
  images      String[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants    Variant[]
  orderItems  OrderItem[]
}

model Variant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  size       String
  color      String
  sku        String   @unique
  stock      Int      @default(0)
  priceDelta Int      @default(0)

  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  address   String?
  createdAt DateTime @default(now())

  orders    Order[]
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum OrderSource {
  WEB
  INSTAGRAM_MANUAL
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)
  source     OrderSource @default(WEB)
  totalPrice Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      OrderItem[]
  payment    Payment?
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Int
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  authority     String?
  refId         String?
  amount        Int
  isSuccessful  Boolean  @default(false)
  createdAt     DateTime @default(now())
}
