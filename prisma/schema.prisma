datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InventoryMode {
  SINGLE
  MULTI
}

enum QualityGrade {
  N
  A_PLUS
  A
  B
  C
}

model Product {
  id          String   @id @default(uuid())
  title       String
  productCode String?  @unique
  description String?
  basePrice   Int
  images      String[]
  isActive    Boolean  @default(true)

  // اطلاعات پایه محصول
  brand       String?
  modelName   String?
  productType String? // Priority category; also the legacy API field.
  mainCategories String[] @default([])

  // Product-first attributes; legacy tags remain untouched.
  fabrics            String[] @default([])
  fabricBasis        FabricBasis @default(UNKNOWN)
  mainFabric         String?
  complementaryFabrics String[] @default([])
  garmentDesign      String?
  hasHood            Boolean?
  seasons            String[] @default([])
  uses               String[] @default([])
  fabricTechnology   String?
  technologyVerified Boolean @default(false)
  technologyEvidence String?
  fabricNote         String?
  defectImages       String[] @default([])

  // لایه اول: نیاز مشتری
  customerNeeds String[]

  // لایه دوم: احساس / سبک
  styles        String[]

  // نحوه مدیریت موجودی
  inventoryMode InventoryMode @default(MULTI)

  // وضعیت و کیفیت
  qualityGrade QualityGrade?
  condition    String?
  defect       String?

  // هویت محصول
  identityOrigin      String?
  identityHistory     String?
  identityPurpose     String?
  identityUseCases    String?
  identityDesign      String?
  identityTechnical   String?
  identitySources     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants   Variant[]
  orderItems OrderItem[]
}

enum FabricBasis {
  SELLER
  LABEL
  UNKNOWN
}

model FabricOption {
  key   String @id
  label String
}

model Variant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // اطلاعات فعلی - برای سازگاری با سیستم موجود
  size       String
  color      String
  sku        String @unique
  stock      Int    @default(0)
  priceDelta Int    @default(0)

  // اندازه‌های واقعی
  chestWidthCm Float?
  lengthCm     Float?
  sleeveFromNeckCm Float?

  // اندازه‌های شلوار
  waistCm       Float?
  // Flat garment waistband width, explicitly measured; never inferred from waistCm.
  waistWidthCm  Float?
  riseCm        Float?
  totalLengthCm Float?
  thighWidthCm  Float?
  hemWidthCm    Float?

  // اطلاعات اختصاصی آیتم
  itemGrade     QualityGrade?
  itemCondition String?
  itemDefect    String?
  itemImages    String[]
  itemDefectImages String[] @default([])

  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model CheckoutReservation {
  orderId String @id
  order Order @relation(fields: [orderId], references: [id])
  requestKey String @unique
  requestHash String
  fullName String
  phone String
  address String
  province String
  city String
  postalCode String
  shippingFee Int
  expiresAt DateTime

  @@index([expiresAt])
}

model ShippingSettings {
  id String @id
  fee Int
}


model CardTransfer {
  paymentId String @id
  payment Payment @relation(fields: [paymentId], references: [id])
  receipt Bytes
  reviewedAt DateTime?
  rejected Boolean @default(false)
}

model CardTransferSettings {
  id String @id
  cardNumber String
  accountHolder String
  enabled Boolean @default(false)
}

model OrderTrackingChallenge {
  id String @id
  orderId String
  phone String
  tokenHash String
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([phone, createdAt])
}

model ZibalAttempt {
  paymentId String @id
  payment Payment @relation(fields: [paymentId], references: [id])
  trackId String? @unique
  state String @default("STARTING")
  trackIssuedAt DateTime?
}

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  address   String?
  createdAt DateTime @default(now())

  orders Order[]
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum OrderSource {
  WEB
  INSTAGRAM_MANUAL
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)
  source     OrderSource @default(WEB)
  totalPrice Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items   OrderItem[]
  payment Payment?
  checkout CheckoutReservation?
  shipmentTrackingCode String?
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Int
}

model Payment {
  id           String   @id @default(uuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id])
  authority    String?
  refId        String?
  amount       Int
  isSuccessful Boolean  @default(false)
  cardTransfer CardTransfer?
  zibalAttempt ZibalAttempt?
  createdAt    DateTime @default(now())
}

model SiteContent {
  id        String   @id
  version   Int      @default(0)
  draft     Json
  published Json
  history   Json
  updatedAt DateTime @updatedAt
}


model AdminSession {
  tokenHash         String   @id
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  @@index([expiresAt])
}

// Phase B tables are installed only by the guarded local test setup.
model SmartDossier {
  id              String   @id @default(uuid())
  version         Int      @default(0)
  phase           String   @default("draft")
  proposedCode    String?
  approvedVersion Int?
  productId       String?  @unique
  payload         Json
  archivedAt      DateTime?
  retiredReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  images          SmartImage[]
  approvals       SmartApproval[]
  reservation     SmartCode?
}

model SmartCode {
  code       String       @id
  dossierId  String?      @unique
  dossier    SmartDossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  reservedAt DateTime     @default(now())
}

model SmartImage {
  id          String       @id
  dossierId   String
  dossier     SmartDossier @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  name        String
  size        Int
  digest      String
  bytes       Bytes?
  createdAt   DateTime     @default(now())

  @@index([dossierId])
}

model SmartApproval {
  dossierId String
  version   Int
  snapshot  Json
  at        DateTime @default(now())
  dossier   SmartDossier @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  @@id([dossierId, version])
}

model SmartEvent {
  id        String   @id @default(uuid())
  dossierId String
  action    String
  version   Int
  actor     String
  at        DateTime @default(now())

  @@index([dossierId, at])
}

// Durable execution reservation, including uncertain provider outcomes.
model SmartAiRun {
  id        String   @id
  operation String
  scope     String   @default("pilot")
  dossierId String
  version   Int
  status    String
  model     String
  usage     Json?
  result    Json?
  rawResponse String?
  errorCode String?
  at        DateTime @default(now())

  @@unique([operation, scope])
  @@index([at])
}
